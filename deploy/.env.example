# Copy this file only to the protected server secret directory. Never commit a populated .env file.
APP_ENV=production
HTTP_ADDR=:8080
REQUIRE_DEPENDENCIES=true
POSTGRES_DB=xkjy
POSTGRES_USER=xkjy
POSTGRES_PASSWORD=replace_with_server_generated_value
DATABASE_URL=postgres://xkjy:replace_with_server_generated_value@postgres:5432/xkjy?sslmode=disable
REDIS_URL=redis://redis:6379/0
# Admin binds to 127.0.0.1:18089 in P00. Publish it through the server reverse proxy only after a separate security review.
ANDROID_KEYSTORE_FILE=/secrets/xkjy-p00-release.jks
ANDROID_KEYSTORE_PASSWORD=replace_with_server_generated_value
ANDROID_KEY_ALIAS=xkjy-p00
ANDROID_KEY_PASSWORD=replace_with_server_generated_value
